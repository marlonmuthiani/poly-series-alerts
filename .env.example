# Telegram Bot Token (get from @BotFather)
STREAK_BOT_TOKEN=your_bot_token_here

# Telegram channel for subscription gating (optional)
CHANNEL_USERNAME=@yourchannel
CHANNEL_LINK=https://t.me/yourchannel

# Your social links (shown in /start)
X_LINK=https://x.com/yourprofile

# Proxy for Polymarket API (required in geo-blocked regions)
# PROXY_TURKEY=socks5://user:pass@host:port
# PROXY_RUSSIA=socks5://user:pass@host:port
# HTTPS_PROXY=socks5://user:pass@host:port
